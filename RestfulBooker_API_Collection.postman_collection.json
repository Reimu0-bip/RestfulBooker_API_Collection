                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Kiểm tra tên khách hàng khớp với dữ liệu từ phản hồi\npm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {\n    var jsonData = pm.response.json();\n    // Verify the booking name directly from the response\n    pm.expect(jsonData.booking.firstname).to.not.be.undefined;\n    pm.expect(jsonData.booking.firstname).to.eql(\"Vo Thanh\");\n});\n\n// Lưu lại ID\nvar jsonData = pm.response.json();\npm.environment.set(\"bookingid\", jsonData.bookingid);"
